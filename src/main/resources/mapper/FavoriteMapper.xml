<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!--
    회원이 등록한 즐겨찾기 국가(favorite_country 테이블)를 다루는 MyBatis 매퍼 XML.
    FavoriteMapper.java 인터페이스와 namespace로 연결되며, id 속성이 메서드 이름과 매칭된다.
-->
<mapper namespace="com.example.travelcompass.mapper.FavoriteMapper">

    <!--
        resultMap: favorite_country 테이블 컬럼을 FavoriteCountry 엔티티 필드에 매핑하는 규칙.
        <id>는 PK 컬럼(id), <result>는 나머지 일반 컬럼들이다.
    -->
    <resultMap id="favoriteResultMap" type="com.example.travelcompass.entity.FavoriteCountry">
        <id property="id" column="id"/>
        <result property="memberId" column="member_id"/>
        <result property="countryCode" column="country_code"/>
        <result property="countryName" column="country_name"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <!--
        특정 회원(memberId)이 등록한 즐겨찾기 국가 목록을 조회한다.
        최근에 즐겨찾기한 국가가 먼저 보이도록 created_at 내림차순(DESC)으로 정렬한다.
        결과는 favoriteResultMap 규칙에 따라 FavoriteCountry 객체 리스트로 변환된다.
    -->
    <select id="findAllByMemberId" parameterType="long" resultMap="favoriteResultMap">
        SELECT id, member_id, country_code, country_name, created_at
        FROM favorite_country
        WHERE member_id = #{memberId}
        ORDER BY created_at DESC
    </select>

    <!--
        특정 회원이 특정 국가를 이미 즐겨찾기했는지 개수로 확인한다.
        resultType="int"는 COUNT(*) 결과를 resultMap 없이 바로 int 값으로 받는다는 뜻이다.
        중복 등록(같은 국가를 두 번 즐겨찾기)을 막기 위한 사전 확인용으로 사용된다.
    -->
    <select id="countByMemberIdAndCountryCode" resultType="int">
        SELECT COUNT(*)
        FROM favorite_country
        WHERE member_id = #{memberId}
          AND country_code = #{countryCode}
    </select>

    <!--
        새 즐겨찾기 국가를 등록한다.
        useGeneratedKeys="true" + keyProperty="id" : DB가 자동 채번한 PK를
        INSERT 이후 자바 FavoriteCountry 객체의 id 필드에 채워 넣어준다.
    -->
    <insert id="insert" parameterType="com.example.travelcompass.entity.FavoriteCountry" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO favorite_country (member_id, country_code, country_name)
        VALUES (#{memberId}, #{countryCode}, #{countryName})
    </insert>

    <!--
        즐겨찾기 항목을 삭제한다.
        WHERE 절에 id와 member_id를 함께 걸어, 요청한 회원 본인의 즐겨찾기만
        삭제되도록 소유권을 검증한다(다른 회원의 즐겨찾기를 실수로 지우는 것을 방지).
    -->
    <delete id="deleteByIdAndMemberId">
        DELETE FROM favorite_country
        WHERE id = #{id}
          AND member_id = #{memberId}
    </delete>

</mapper>

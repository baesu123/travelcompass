<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.travelcompass.mapper.MemberMapper">

    <resultMap id="memberResultMap" type="com.example.travelcompass.entity.Member">
        <id property="id" column="id"/>
        <result property="username" column="username"/>
        <result property="password" column="password"/>
        <result property="nickname" column="nickname"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <select id="findByUsername" parameterType="string" resultMap="memberResultMap">
        SELECT id, username, password, nickname, created_at
        FROM member
        WHERE username = #{username}
    </select>

    <select id="findById" parameterType="long" resultMap="memberResultMap">
        SELECT id, username, password, nickname, created_at
        FROM member
        WHERE id = #{id}
    </select>

    <select id="countByUsername" parameterType="string" resultType="int">
        SELECT COUNT(*)
        FROM member
        WHERE username = #{username}
    </select>

    <insert id="insert" parameterType="com.example.travelcompass.entity.Member" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO member (username, password, nickname)
        VALUES (#{username}, #{password}, #{nickname})
    </insert>

</mapper>
